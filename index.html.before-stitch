// --- TRACKING ENGINE LOGIC ---
function handleTrackSearch(e) {
  if (e) e.preventDefault();
  const inputEl = document.getElementById('track-input');
  const query = inputEl.value.trim().toUpperCase().replace(/[^A-Z0-9-]/g, '');
  const container = document.getElementById('track-result-container');
  container.classList.remove('hidden');

  if (!query) {
    return;
  }

  // Lookup in DB or normalize comparison
  let found = CONSIGNMENTS_DB[query];
  if (!found) {
    // Try relaxed search for IXCDEMO123456
    const cleanQuery = query.replace(/[^A-Z0-9]/g, '');
    if (cleanQuery === "IXCDEMO123456") {
      found = CONSIGNMENTS_DB["IXCDEMO123456"];
    } else if (cleanQuery.includes("7701")) {
      found = CONSIGNMENTS_DB["IXC-DOM-7701"];
    } else if (cleanQuery.includes("DEMO001")) {
      found = CONSIGNMENTS_DB["IXC-DEMO-001"];
    }
  }

  if (found) {
    renderSuccessTracking(found, container);
  } else {
    renderNotFoundTracking(query, container);
  }
}

function quickFillTrack(num) {
  const inputEl = document.getElementById('track-input');
  inputEl.value = num;
  handleTrackSearch();
}

